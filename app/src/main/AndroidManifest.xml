<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adit.penjualannya_adit"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Penjualannya_adit"
        android:usesCleartextTraffic="true">

        <!-- 1. Halaman Login (Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Halaman Daftar -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- 3. Dashboard Utama -->
        <activity
            android:name=".MainActivity2"
            android:exported="false" />

        <!-- 4. Halaman Profil Akun -->
        <activity
            android:name=".AkunActivity"
            android:exported="false" />

        <!-- Fitur Kategori -->
        <activity
            android:name=".kategori.DataKategoriActivity"
            android:exported="false" />
        <activity
            android:name=".kategori.ModKategoriActivity"
            android:exported="false" />
        <activity
            android:name=".kategori.DetailKategoriFragment"
            android:exported="false" />

        <!-- Fitur Produk -->
        <activity
            android:name=".TambahProduk"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
