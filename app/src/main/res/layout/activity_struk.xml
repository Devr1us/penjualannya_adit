<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6EB"
    android:id="@+id/main">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5C858A"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#D9E6E6"
                android:layout_centerVertical="true"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Struk Transaksi"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bagikan chat, cetak thermal Bluetooth, atau PDF"
            android:textColor="#E0EBEB"
            android:textSize="13sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsLayout">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">
            
            <!-- Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Chat Sosmed"
                    android:textColor="#9EAEB5"
                    android:layout_marginEnd="8dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Nota Printer"
                    android:textColor="#9EAEB5"
                    android:layout_marginEnd="8dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="PDF"
                    android:textColor="#9EAEB5" />
            </LinearLayout>
            
            <!-- Receipt Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="0dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo sobat RiusShop 👋"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Berikut rincian pesanan Anda di *RiusShop*:"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                    
                    <TextView
                        android:id="@+id/tvIdTransaksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• ID Transaksi: TRX..."
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                    
                    <TextView
                        android:id="@+id/tvTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Tanggal: "
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tvKasir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Kasir: Kasir"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Status: Lunas"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Detail Pesanan:*"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>
                        
                    <!-- Order Items -->
                    <LinearLayout
                        android:id="@+id/llOrderItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />
                        
                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal: Rp0"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Total: Rp0*"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="24dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terima kasih telah berbelanja di *RiusShop* 🙏"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKirimWa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Kirim Chat via WhatsApp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#33D06D"
            android:layout_marginBottom="12dp"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBagikanLain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Bagikan Chat ke Aplikasi Lain"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#5B7E89"
            android:layout_marginBottom="12dp"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCetak"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cetak / Bagikan Nota"
            android:textAllCaps="false"
            android:textColor="#5B7E89"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#5B7E89"
            android:layout_marginBottom="12dp"/>
            
        <TextView
            android:id="@+id/btnSelesai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selesai"
            android:textAlignment="center"
            android:textColor="#777777"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
