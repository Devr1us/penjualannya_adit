<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8"
    android:id="@+id/main">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_brand"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:layout_centerVertical="true"
                android:contentDescription="Kembali"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Nota Transaksi"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsLayout"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Receipt Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- ═══ HEADER TOKO ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛒"
                        android:textSize="36sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvNamaToko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RIUSSHOP"
                        android:textColor="#222222"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:letterSpacing="0.15"/>

                    <TextView
                        android:id="@+id/tvAlamatToko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jl. Contoh No. 123, Kota"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTeleponToko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telp: 08xx-xxxx-xxxx"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp"/>

                    <!-- ═══ DIVIDER DOUBLE ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="════════════════════════════════"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="monospace"/>

                    <!-- ═══ INFO TRANSAKSI ═══ -->
                    <!-- Baris: No. Transaksi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No. Transaksi"
                            android:textColor="#777777"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvIdTransaksi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRX-001"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Baris: Tanggal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tanggal"
                            android:textColor="#777777"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvTanggal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-01-01 12:00"
                            android:textColor="#333333"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Baris: Kasir -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kasir"
                            android:textColor="#777777"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvKasir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kasir"
                            android:textColor="#333333"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Baris: Pembayaran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pembayaran"
                            android:textColor="#777777"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvMetodeBayar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tunai"
                            android:textColor="#333333"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Baris: Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Status"
                            android:textColor="#777777"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selesai"
                            android:textColor="#388E3C"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- ═══ DIVIDER DASH ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- - - - - - - - - - - - - - - - - - - - -"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="monospace"/>

                    <!-- ═══ HEADER TABEL ITEM ═══ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:text="Item"
                            android:textColor="#555555"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Qty"
                            android:textColor="#555555"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="Harga"
                            android:textColor="#555555"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <!-- Garis tipis pemisah -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="8dp"/>

                    <!-- ═══ ORDER ITEMS (Diisi programatik) ═══ -->
                    <LinearLayout
                        android:id="@+id/llOrderItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp" />

                    <!-- ═══ DIVIDER DASH ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- - - - - - - - - - - - - - - - - - - - -"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="monospace"/>

                    <!-- ═══ TOTAL SECTION ═══ -->
                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="#555555"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textColor="#333333"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Diskon -->
                    <LinearLayout
                        android:id="@+id/layoutDiskon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Diskon"
                            android:textColor="#E53935"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvDiskon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- Rp 0"
                            android:textColor="#E53935"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Garis total -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="#333333"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Jumlah item -->
                    <TextView
                        android:id="@+id/tvJumlahItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total: 0 item"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:layout_marginBottom="12dp"/>

                    <!-- ═══ DIVIDER DOUBLE ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="════════════════════════════════"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="monospace"/>

                    <!-- ═══ FOOTER ═══ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Terima kasih telah berbelanja!"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:gravity="center"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Barang yang sudah dibeli tidak dapat\nditukar atau dikembalikan."
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="── Powered by RiusShop ──"
                        android:textColor="#BBBBBB"
                        android:textSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Cetak Sekarang -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKirimWa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🖨️  Cetak Struk"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary_brand"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            android:layout_marginBottom="8dp"/>

        <!-- Bagikan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBagikanLain"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📤  Bagikan Struk"
            android:textAllCaps="false"
            android:textColor="@color/primary_brand"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_brand"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/btnSelesai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selesai"
            android:textAlignment="center"
            android:textColor="#999999"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
