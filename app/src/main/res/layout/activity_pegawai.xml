<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section (Teal Background) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C858A"
            android:orientation="vertical"
            android:padding="24dp">
            
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#D9E6E6"
                    android:layout_centerVertical="true"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Pengelolaan Pegawai"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tambah, edit, hapus, dan atur cabang pegawai"
                android:textColor="#E0EBEB"
                android:textSize="13sp"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="7dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Form Pegawai"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNamaPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="18dp"
                    android:hint="Nama pegawai"
                    android:backgroundTint="#5B5FEF"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary" />

                <EditText
                    android:id="@+id/edtEmailPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="14dp"
                    android:hint="Email pegawai"
                    android:inputType="textEmailAddress"
                    android:backgroundTint="#5B5FEF"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary" />

                <EditText
                    android:id="@+id/edtTeleponPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="14dp"
                    android:hint="Nomor telepon"
                    android:inputType="phone"
                    android:backgroundTint="#5B5FEF"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary" />

                <EditText
                    android:id="@+id/edtJabatanPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="14dp"
                    android:hint="Jabatan"
                    android:backgroundTint="#5B5FEF"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Penempatan Cabang"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerCabang"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp" />

                <Switch
                    android:id="@+id/switchStatusPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Pegawai Aktif"
                    android:textColor="?android:textColorPrimary"
                    android:checked="true" />

                <Button
                    android:id="@+id/btnSimpanPegawai"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="22dp"
                    android:text="Simpan Pegawai"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#5C858A" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Daftar Pegawai"
            android:textColor="?android:textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPegawai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>
    </LinearLayout>

</ScrollView>
